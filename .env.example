# ==================== ОСНОВНЫЕ НАСТРОЙКИ ====================
# Токен вашего Telegram-бота (от @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администраторов через запятую (например: 374188835,123456789)
ADMIN_IDS=374188835

# ==================== БАЗА ДАННЫХ ====================
# 1. Для локальной разработки (SQLite):
DB_PATH=data/contractors.db

# 2. Для продакшена на Render / Supabase (PostgreSQL):
# Оставьте пустым, чтобы использовать SQLite, либо укажите connection string PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ==================== КАТАЛОГ И WEB APP ====================
# Путь к PDF файлу каталога/прайс-листа
CATALOG_PDF_PATH=assets/price_catalog.pdf

# (Опционально) URL веб-приложения Mini App с тулбаром Liquid Glass
WEBAPP_URL=

# ==================== НАСТРОЙКИ ВЕБ-ПАРСЕРА ====================
# API-ключ поискового сервиса Serper.dev (Google Search API)
# Обеспечивает 2,500 бесплатных запросов Google без блокировок дата-центров Render.
# Регистрация за 1 минуту: https://serper.dev
SERPER_API_KEY=
# SEARCH_API_KEY= (поддерживается как альтернативное имя)

# Количество параллельных потоков обхода сайтов (рекомендуется 8)
PARSER_CONCURRENCY=8
PARSER_TIMEOUT=10

# Поисковые запросы через запятую
SEARCH_QUERIES=благоустройство детские площадки,установка детских городков маф,производство заборов ограждений,подрядчики благоустройство территорий,поставка мафов для парков,ограждения детских садов и школ

# Целевые регионы для сбора через запятую
TARGET_REGIONS=Москва и МО,Санкт-Петербург,Краснодарский край,Екатеринбург,Казань,Новосибирск,Нижний Новгород,Ростов-на-Дону

# Стартовые сайты/каталоги компаний через запятую
SEED_URLS=https://rostov-gorod.ru,https://parki-rossii.ru,https://blagoustroystvo.info

# Задержка между запросами парсера в секундах
PARSER_DELAY=1.5

# Максимальное количество сайтов на один запрос
PARSER_MAX_PER_QUERY=15
